KEVENOS_HOSTED=0
KEVENOS_PUBLIC_URL=https://event.example.com
KEVENOS_DATA=/data
KEVENOS_PORT=8080
# Storage: sqlite (default), postgres, or supabase.
KEVENOS_DB_BACKEND=sqlite
# Required for postgres/supabase; POSTGRES_URL and DATABASE_URL are accepted aliases.
# Use a secret manager in hosted deployments.
# KEVENOS_DATABASE_URL=postgresql://user:password@database.example.com:5432/postgres
KEVENOS_DB_SCHEMA_PREFIX=kevenos
# Optional integration values are documented in README.md. Supply secrets
# through your deployment secret manager; never commit them here.
