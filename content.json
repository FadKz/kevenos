  "steps": [
    {
      "n": "1",
      "name": "Discover",
      "minutes": 2,
      "line": "Ask questions. Find the trigger, the users, the apps and who decides. Name the type."
    },
    {
      "n": "2",
      "name": "Solution at Work",
      "minutes": 3,
      "line": "One point each for users, IT and business, with on-device AI where it fits. The right solution device for two roles."
    },
    {
      "n": "3",
      "name": "Solve",
      "minutes": 3,
      "line": "Take one IT and one business objection: the solution device answer, then the implementation partner service."
    },
    {
      "n": "4",
      "name": "Close",
      "minutes": 2,
      "line": "Ask for a free, no-obligation Discovery meeting with their IT and the implementation partner Technical team. Say why it helps: their pain from Discover. Agree a date."
    }
  ],
  "rubric": [
    {
      "name": "1  Discover",
      "points": 30,
      "ticks": [
        {
          "id": "D1",
          "text": "Asked about the people: how many use laptops, and who uses a solution device or mobile device (Q1, Q2)",
          "points": 10,
          "counts": "Both: how many laptop users, and who already uses a solution device or mobile device.",
          "short": "Asked how many use laptops, and who uses a solution device or mobile device"
        },
        {
          "id": "D2",
          "text": "Found why now: what changed, or the refresh date (Q3 or Q13)",
          "points": 10,
          "counts": "They ask what changed, or when laptops are due to be replaced.",
          "short": "Found why now: what changed, or the refresh date"
        },
        {
          "id": "D3",
          "text": "Named the type, A or B, and gave a reason",
          "points": 10,
          "counts": "You ask in the feedback: 'Which type, and why?' Right type and one reason.",
          "short": "Named the type, A or B, with a reason"
        }
      ]
    },
    {
      "name": "2  Solution at Work",
      "points": 20,
      "ticks": [
        {
          "id": "M1",
          "text": "A point for users, one for IT and one for business, each linked to this customer",
          "points": 10,
          "counts": "All three points, each using something the customer said. Two of three is no tick.",
          "short": "A point for users, IT and business, tied to this customer"
        },
        {
          "id": "M2",
          "text": "Named the right solution device for two roles",
          "points": 10,
          "counts": "Two roles, each with a solution device that fits. Any fitting solution device counts.",
          "short": "Named the right solution device for two roles"
        }
      ]
    },
    {
      "name": "3  Solve",
      "points": 30,
      "ticks": [
        {
          "id": "S1",
          "text": "IT worry: understood it and gave the solution device answer",
          "points": 10,
          "counts": "Both: they say they understand the worry, then give a solution device fact.",
          "short": "IT worry: understood it and gave the solution device answer"
        },
        {
          "id": "S2",
          "text": "Business worry: understood it and gave the solution device answer",
          "points": 10,
          "counts": "Both: they say they understand the worry, then give a solution device fact.",
          "short": "Business worry: understood it and gave the solution device answer"
        },
        {
          "id": "S3",
          "text": "Named a implementation partner service that answers each worry",
          "points": 10,
          "counts": "Both worries have a service named, from the cheat sheet. One of two is no tick.",
          "short": "Named a implementation partner service for each worry"
        }
      ]
    },
    {
      "name": "4  Close",
      "points": 20,
      "ticks": [
        {
          "id": "C1",
          "text": "Asked for a Discovery meeting with the customer's IT and the implementation partner Technical team, and said why it helps",
          "points": 10,
          "counts": "Both: their IT and the implementation partner Technical team join, and a reason tied to the pain they found in Discover.",
          "short": "Asked for a Discovery meeting: customer IT and the implementation partner Technical team"
        },
        {
          "id": "C2",
          "text": "Agreed a date for the meeting, and who from IT joins (Q24)",
          "points": 10,
          "counts": "A named date, and a named person from the customer's IT.",
          "short": "Agreed a date and a named person from the customer's IT"
        }
      ]
    }
  ],
